+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createAssetRecord, importAssetFiles } = require('../src/asset-import.js');
+
+class SuccessfulReader {
+  readAsDataURL(file) { this.result = `data:${file.type || 'application/octet-stream'};base64,QUJD`; this.onload(); }
+}
+
+class FailedReader {
+  readAsDataURL() { this.error = new Error('simulated read failure'); this.onerror(); }
+}
+
+class AbortedReader {
+  readAsDataURL() { this.onabort(); }
+}
+
+test('asset import creates a data URL record after successful reading', async () => {
+  const record = await createAssetRecord({ name: 'road.png', type: 'image/png', size: 3 }, 'asset_1', { FileReader: SuccessfulReader });
+  assert.equal(record.id, 'asset_1');
+  assert.equal(record.name, 'road.png');
+  assert.equal(record.data, 'data:image/png;base64,QUJD');
+});
+
+test('asset import rejects oversized files before reading', async () => {
+  let readerCreated = false;
+  class NeverReader { constructor() { readerCreated = true; } }
+  await assert.rejects(
+    createAssetRecord({ name: 'huge.bin', type: 'application/octet-stream', size: 20 }, 'asset_2', { maxBytes: 10, FileReader: NeverReader }),
+    /بزرگ‌تر از سقف/
+  );
+  assert.equal(readerCreated, false);
+});
+
+test('asset import reports FileReader errors and aborts instead of hanging', async () => {
+  const file = { name: 'broken.png', type: 'image/png', size: 3 };
+  await assert.rejects(createAssetRecord(file, 'asset_3', { FileReader: FailedReader }), /simulated read failure/);
+  await assert.rejects(createAssetRecord(file, 'asset_4', { FileReader: AbortedReader }), /لغو شد/);
+});
+
+test('asset import rejects missing FileReader and invalid file metadata', async () => {
+  await assert.rejects(createAssetRecord({ name: '', type: 'text/plain', size: 1 }, 'asset_5', { FileReader: SuccessfulReader }), /مشخصات فایل معتبر نیست/);
+  await assert.rejects(createAssetRecord({ name: 'x', type: 'text/plain', size: 1 }, 'asset_6', { FileReader: undefined }), /FileReader/);
+});
+
+
+test('failed duplicate replacement preserves the previous asset and later files continue', async () => {
+  class MixedReader {
+    readAsDataURL(file) {
+      if (file.name === 'same.png') {
+        this.error = new Error('read failed');
+        this.onerror();
+      } else {
+        this.result = `data:${file.type};base64,QUJD`;
+        this.onload();
+      }
+    }
+  }
+  const original = { id: 'old', name: 'same.png', type: 'image/png', size: 3, data: 'data:image/png;base64,OLD' };
+  const result = await importAssetFiles(
+    [original],
+    [
+      { name: 'same.png', type: 'image/png', size: 3 },
+      { name: 'new.png', type: 'image/png', size: 3 }
+    ],
+    { FileReader: MixedReader, createId: file => `new-${file.name}`, confirmReplace: () => true }
+  );
+  assert.equal(result.imported, 1);
+  assert.equal(result.errors.length, 1);
+  assert.equal(result.assets.find(asset => asset.name === 'same.png'), original);
+  assert.ok(result.assets.some(asset => asset.name === 'new.png'));
+});
+
+test('declined duplicate replacement is skipped without reading the file', async () => {
+  let reads = 0;
+  class CountingReader { readAsDataURL() { reads++; this.result = 'data:text/plain;base64,QQ=='; this.onload(); } }
+  const original = { id: 'old', name: 'same.txt', type: 'text/plain', size: 1 };
+  const result = await importAssetFiles([original], [{ name: 'same.txt', type: 'text/plain', size: 1 }], {
+    FileReader: CountingReader, createId: () => 'new', confirmReplace: () => false
+  });
+  assert.equal(result.skipped, 1);
+  assert.equal(result.imported, 0);
+  assert.equal(reads, 0);
+  assert.equal(result.assets[0], original);
+});
