+(function (root) {
+  'use strict';
+
+  const DEFAULT_MAX_BYTES = 15 * 1024 * 1024;
+
+  function readAsDataURL(file, Reader = root.FileReader) {
+    return new Promise((resolve, reject) => {
+      if (typeof Reader !== 'function') {
+        reject(new Error('FileReader در این محیط در دسترس نیست.'));
+        return;
+      }
+      let reader;
+      try {
+        reader = new Reader();
+        reader.onload = () => {
+          if (typeof reader.result === 'string' && reader.result.startsWith('data:')) {
+            resolve(reader.result);
+          } else {
+            reject(new Error('مرورگر دادهٔ فایل را به قالب قابل‌ذخیره تبدیل نکرد.'));
+          }
+        };
+        reader.onerror = () => reject(reader.error || new Error('خواندن فایل ناموفق بود.'));
+        reader.onabort = () => reject(new Error('خواندن فایل لغو شد.'));
+        reader.readAsDataURL(file);
+      } catch (error) {
+        reject(error);
+      }
+    });
+  }
+
+  async function createAssetRecord(file, id, options = {}) {
+    const maxBytes = Number.isFinite(options.maxBytes) ? options.maxBytes : DEFAULT_MAX_BYTES;
+    if (!file || typeof file.name !== 'string' || !file.name.trim() || !Number.isFinite(file.size) || file.size < 0) {
+      throw new Error('مشخصات فایل معتبر نیست.');
+    }
+    if (file.size > maxBytes) {
+      throw new Error(`فایل بزرگ‌تر از سقف ${Math.round(maxBytes / 1024 / 1024)} مگابایت است.`);
+    }
+    const data = await readAsDataURL(file, options.FileReader || root.FileReader);
+    return {
+      id,
+      name: file.name,
+      type: file.type || 'application/octet-stream',
+      size: file.size,
+      data,
+      addedAt: new Date().toISOString()
+    };
+  }
+
+  async function importAssetFiles(existingAssets, files, options = {}) {
+    const assets = Array.isArray(existingAssets) ? existingAssets.slice() : [];
+    const result = { assets, imported: 0, skipped: 0, errors: [] };
+    for (const file of Array.from(files || [])) {
+      const existingIndex = assets.findIndex(asset => asset && asset.name === file?.name);
+      const existing = existingIndex >= 0 ? assets[existingIndex] : null;
+      if (existing) {
+        let approved = false;
+        try { approved = typeof options.confirmReplace === 'function' && options.confirmReplace(file, existing); }
+        catch (error) {
+          result.errors.push({ fileName: file?.name || '', message: error.message || 'تأیید جایگزینی ناموفق بود.' });
+          continue;
+        }
+        if (!approved) {
+          result.skipped++;
+          continue;
+        }
+      }
+      try {
+        const id = typeof options.createId === 'function' ? options.createId(file) : '';
+        const record = await createAssetRecord(file, id, options);
+        if (existing) assets.splice(existingIndex, 1);
+        assets.push(record);
+        result.imported++;
+      } catch (error) {
+        result.errors.push({ fileName: file?.name || '', message: error.message || 'ورود فایل ناموفق بود.' });
+      }
+    }
+    return result;
+  }
+
+  const api = { DEFAULT_MAX_BYTES, readAsDataURL, createAssetRecord, importAssetFiles };
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+  if (root) root.ShahrakEngineAssets = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this);
