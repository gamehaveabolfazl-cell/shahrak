+++ b/tests/travel-fallback.test.cjs
@@ -0,0 +1,31 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { distanceKm, estimate } = require('../game/travel-fallback.js');
+
+const kerman = { lat: 30.2832, lon: 57.0788 };
+const raver = { lat: 31.266, lon: 56.806 };
+
+test('direct fallback computes a non-zero geographic distance for an isolated destination', () => {
+  const distance = distanceKm(kerman, raver);
+  assert.ok(distance > 100 && distance < 130, `unexpected distance ${distance}`);
+  const trip = estimate({ nearestCity: kerman, target: raver });
+  assert.equal(trip.routeFallback, true);
+  assert.equal(trip.path.length, 0);
+  assert.ok(trip.roadKm > distance);
+});
+
+test('fallback includes the player approach leg to the nearest city', () => {
+  const base = estimate({ nearestCity: kerman, target: raver });
+  const withApproach = estimate({ nearestCity: kerman, target: raver, playerToNearestKm: 12 });
+  assert.equal(withApproach.roadKm - base.roadKm, 12);
+});
+
+test('identical points produce zero direct distance', () => {
+  assert.equal(distanceKm(kerman, kerman), 0);
+});
+
+test('invalid coordinates and unsafe estimate options are rejected', () => {
+  assert.throws(() => distanceKm(kerman, { lat: NaN, lon: 57 }), /مختصات/);
+  assert.throws(() => estimate({ nearestCity: kerman, target: raver, playerToNearestKm: -1 }), /فاصله/);
+  assert.throws(() => estimate({ nearestCity: kerman, target: raver, detourFactor: 3 }), /ضریب/);
+});
