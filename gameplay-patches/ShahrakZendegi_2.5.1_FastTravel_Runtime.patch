+++ b/game/travel-fallback.js
@@ -0,0 +1,48 @@
+(function (root) {
+  'use strict';
+
+  const EARTH_RADIUS_KM = 6371;
+
+  function validPoint(point) {
+    return !!point && Number.isFinite(Number(point.lat)) && Number.isFinite(Number(point.lon));
+  }
+
+  function distanceKm(a, b) {
+    if (!validPoint(a) || !validPoint(b)) {
+      throw new TypeError('مختصات مبدأ و مقصد برای برآورد سفر معتبر نیستند.');
+    }
+    const rad = value => value * Math.PI / 180;
+    const dLat = rad(Number(b.lat) - Number(a.lat));
+    const dLon = rad(Number(b.lon) - Number(a.lon));
+    const latA = rad(Number(a.lat));
+    const latB = rad(Number(b.lat));
+    const h = Math.sin(dLat / 2) ** 2 + Math.cos(latA) * Math.cos(latB) * Math.sin(dLon / 2) ** 2;
+    return EARTH_RADIUS_KM * 2 * Math.asin(Math.sqrt(Math.min(1, h)));
+  }
+
+  function estimate(options = {}) {
+    const nearestCity = options.nearestCity;
+    const target = options.target;
+    const approachKm = Number(options.playerToNearestKm ?? 0);
+    const detourFactor = Number(options.detourFactor ?? 1.08);
+    if (!Number.isFinite(approachKm) || approachKm < 0) {
+      throw new RangeError('فاصلهٔ بازیکن تا نزدیک‌ترین شهر معتبر نیست.');
+    }
+    if (!Number.isFinite(detourFactor) || detourFactor < 1 || detourFactor > 2) {
+      throw new RangeError('ضریب برآورد مسیر باید بین ۱ و ۲ باشد.');
+    }
+    const directKm = distanceKm(nearestCity, target);
+    return {
+      roadKm: approachKm + directKm * detourFactor,
+      seaKm: 0,
+      directKm,
+      approachKm,
+      routeFallback: true,
+      path: []
+    };
+  }
+
+  const api = { EARTH_RADIUS_KM, distanceKm, estimate };
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+  if (root) root.ShahrakTravelFallback = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this);
